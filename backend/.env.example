# backend/.env
# Farm Connect Python Backend Configuration

# Server
PORT=5000
HOST=0.0.0.0
DEBUG=false
LOG_LEVEL=info
CORS_ORIGINS=*

# Admin Secret Key
ADMIN_SECRET_KEY=farm_admin_secret_key_2025

# Database (sqlite default; or postgres)
DB_DRIVER=sqlite
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/farm_connect

# AI & LLM Provider (gemini | openai | ollama)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI / Ollama (optional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB RAG (local | http)
CHROMA_MODE=local

# Session state (memory | redis)
SESSION_BACKEND=memory

# Email / SMTP Verification (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
