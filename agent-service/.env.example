# agent-service/.env
# Copy this file and fill in real values.
# DO NOT commit the filled-in version to git.

# ── Service ────────────────────────────────────────────────────────────────────
PORT=8000
DEBUG=false
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────────
# "sqlite" shares the Node backend's file (default).
# Set to "postgres" and fill DATABASE_URL to use PostgreSQL.
DB_DRIVER=sqlite

# SQLite: auto-resolved to ../backend/farm_connect.sqlite (leave blank to use default)
# SQLITE_PATH=../backend/farm_connect.sqlite

# PostgreSQL DSN (only used when DB_DRIVER=postgres)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/farm_connect

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Options: gemini | openai | ollama
LLM_PROVIDER=gemini

# Gemini (matches the Node backend)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (leave blank if using gemini/ollama)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=          # blank = official API; set for local proxy

# Ollama (local, no key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Shared LLM tuning
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── ChromaDB ───────────────────────────────────────────────────────────────────
# "local" = persist to disk. "http" = connect to a running ChromaDB server.
CHROMA_MODE=local
# CHROMA_PATH=./rag/chroma_db     # default; relative to agent-service/

# Remote ChromaDB (only used when CHROMA_MODE=http)
# CHROMA_HOST=localhost
# CHROMA_PORT=8100

# ── Session state ──────────────────────────────────────────────────────────────
# "memory" = in-process dict (fine for dev / single worker).
# "redis"  = persistent across restarts and multiple workers.
SESSION_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
